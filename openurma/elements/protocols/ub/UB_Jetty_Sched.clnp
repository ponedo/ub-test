// SPDX-License-Identifier: Apache-2.0
//
// UB_Jetty_Sched: round-robin scheduler over per-Jetty work-request queues.
// Implements application-level **Fence** semantics (spec §7.3.2.2 note):
// a fenced WR waits until all prior Read and Atomic from this Initiator
// have responded.
//
// Multi-flit-aware (v3): a WR can span multiple flits (meta + ext +
// payload flits). Non-sop flits are queued under the SAME INI as the
// most recent sop, and drained as a contiguous packet (sop→eop) before
// the RR cursor advances. This preserves FIFO order across the entire
// packet — which earlier versions accidentally violated when single-flit
// scheduling assumed one flit per WR.
//
// Local prototype changes: optional payload-byte DRR (WRITE length from the
// queued extension); other/metadata-only WRs cost 64 service credits. RR is
// still the default. No wire or WR fields are changed. Full queues retain
// the backend input slot with peek_input_port rather than dropping its flit.
// CPU/SystemC selection configuration is public generated State_t, not a
// claim of an implemented FPGA host-control interface.
//
// Inputs : port 1 = WR flits from Doorbell (multi-flit packets allowed)
//          port 2 = Read/Atomic completion notifications (lane 0=ini_rc_id)
// Outputs: port 1 = WR flits ready for OrderTracker_Initiator

.element UB_Jetty_Sched <2, 1> {
    .timing { ii = 2; }
    .state {
        constexpr uint32_t MAX_INI       = 16;
        constexpr uint32_t INI_MASK      = MAX_INI - 1;
        constexpr uint32_t QUEUE_DEPTH   = 32;
        struct WR {
            openclicknp::flit_t f;
            uint8_t valid;
            uint8_t fence;
            uint8_t is_sop;
            uint8_t is_eop;
        };
        struct IniQ {
            WR wrs[QUEUE_DEPTH];
            uint32_t head;
            uint32_t tail;
            uint32_t outstanding_read_atomic;
        };
        IniQ q[MAX_INI];
        uint32_t rr_cursor;
        uint32_t use_drr = 0;
        uint64_t quantum_bytes = 256;
        uint64_t deficit[MAX_INI];
        uint8_t drr_visit_active;
        uint64_t input_full_cycles;
        // Input-side packet tracking: route non-sop flits to the same
        // INI as the most recent sop they belong to.
        uint32_t cur_input_ini;
        uint8_t  in_packet_input;
        // Drain-side packet tracking: once we start emitting a packet
        // from an INI, stay on that INI until we drain its eop.
        int32_t  drain_active_ini;
        uint8_t  drain_in_packet;
    }
    .init {
        for (uint32_t i = 0; i < _state.MAX_INI; ++i) {
            _state.deficit[i] = 0;
            _state.q[i].head = 0;
            _state.q[i].tail = 0;
            _state.q[i].outstanding_read_atomic = 0;
            for (uint32_t j = 0; j < _state.QUEUE_DEPTH; ++j) {
                _state.q[i].wrs[j].valid = 0;
            }
        }
        _state.drr_visit_active = 0;
        _state.input_full_cycles = 0;
        _state.rr_cursor = 0;
        _state.cur_input_ini = 0;
        _state.in_packet_input = 0;
        _state.drain_active_ini = -1;
        _state.drain_in_packet = 0;
    }
    .handler {
        if (test_input_port(PORT_2)) {
            openclicknp::flit_t cn = read_input_port(PORT_2);
            uint32_t ini = (uint32_t)(cn.get(0) & 0xFFFFFu);
            uint32_t idx = ini & _state.INI_MASK;
            if (_state.q[idx].outstanding_read_atomic > 0) {
                _state.q[idx].outstanding_read_atomic--;
            }
        }
        if (test_input_port(PORT_1)) {
            openclicknp::flit_t f = peek_input_port(1);
            uint32_t idx;
            uint8_t  fence_bit = 0;
            if (f.sop()) {
                openurma::ub_meta m{f};
                idx = m.ini_rc_id() & _state.INI_MASK;
                fence_bit = m.fence() ? 1 : 0;

            } else if (_state.in_packet_input) {
                idx = _state.cur_input_ini & _state.INI_MASK;

            } else {
                read_input_port(PORT_1);
                // Stray non-sop flit (no preceding sop). Drop quietly.
                return PORT_1;
            }
            uint32_t t = _state.q[idx].tail;
            uint32_t nt = (t + 1) % _state.QUEUE_DEPTH;
            if (nt != _state.q[idx].head) {
                read_input_port(PORT_1);
                if (f.sop()) {
                    _state.cur_input_ini = idx;
                    _state.in_packet_input = f.eop() ? 0 : 1;
                } else if (f.eop()) _state.in_packet_input = 0;
                _state.q[idx].wrs[t].f = f;
                _state.q[idx].wrs[t].valid = 1;
                _state.q[idx].wrs[t].fence = fence_bit;
                _state.q[idx].wrs[t].is_sop = f.sop() ? 1 : 0;
                _state.q[idx].wrs[t].is_eop = f.eop() ? 1 : 0;
                _state.q[idx].tail = nt;
            } else {
                ++_state.input_full_cycles;
            }
        }
        // Drain logic: if currently in the middle of emitting a packet,
        // stay on that INI until we emit its eop. Otherwise, RR-pick.
        {
            int32_t drain_idx = _state.drain_active_ini;
            if (_state.drain_in_packet == 0 && _state.use_drr) {
                uint32_t i = _state.rr_cursor & _state.INI_MASK;
                bool advance = false;
                if (_state.q[i].head == _state.q[i].tail) {
                    _state.deficit[i] = 0;
                    advance = true;
                } else {
                    uint32_t h = _state.q[i].head;
                    bool blocked = !_state.q[i].wrs[h].is_sop
                        || (_state.q[i].wrs[h].fence && _state.q[i].outstanding_read_atomic > 0);
                    bool known = true;
                    uint64_t cost = 64; // Explicit non-payload service credit.
                    openurma::ub_meta m{_state.q[i].wrs[h].f};
                    if (!blocked && m.ta_opcode() == openurma::TAOP_WRITE && !_state.q[i].wrs[h].is_eop) {
                        uint32_t e = (h + 1) % _state.QUEUE_DEPTH;
                        known = e != _state.q[i].tail && !_state.q[i].wrs[e].is_sop;
                        if (known) {
                            openurma::ub_ext ext{_state.q[i].wrs[e].f};
                            cost = ext.length();
                            if (cost == 0) cost = 1; // Finite cost for an empty WRITE.
                        }
                    }
                    if (blocked || !known) advance = true;
                    else {
                        if (!_state.drr_visit_active) {
                            _state.deficit[i] += _state.quantum_bytes;
                            _state.drr_visit_active = 1;
                        }
                        if (_state.deficit[i] >= cost) {
                            _state.deficit[i] -= cost;
                            drain_idx = (int32_t)i;
                            _state.drain_active_ini = drain_idx;
                            _state.drain_in_packet = 1;
                        } else advance = true;
                    }
                }
                if (advance) {
                    _state.rr_cursor = (_state.rr_cursor + 1) & _state.INI_MASK;
                    _state.drr_visit_active = 0;
                }
            }
            if (_state.drain_in_packet == 0 && !_state.use_drr) {
                uint32_t i = _state.rr_cursor & _state.INI_MASK;
                _state.rr_cursor = (_state.rr_cursor + 1) & _state.INI_MASK;
                if (_state.q[i].head != _state.q[i].tail) {
                    uint32_t h = _state.q[i].head;
                    bool is_sop_at_head = (_state.q[i].wrs[h].is_sop != 0);
                    bool fence_blocked = (_state.q[i].wrs[h].fence
                                       && _state.q[i].outstanding_read_atomic > 0);
                    if (is_sop_at_head && !fence_blocked) {
                        drain_idx = (int32_t)i;
                        _state.drain_active_ini = drain_idx;
                        _state.drain_in_packet = 1;
                    } else if (!is_sop_at_head) {
                        // Garbage non-sop at head: shouldn't happen with
                        // multi-flit-aware enqueue, but tolerate.
                        drain_idx = -1;
                    }
                }
            }
            if (drain_idx >= 0 && _state.drain_in_packet) {
                uint32_t i = (uint32_t)drain_idx;
                if (_state.q[i].head != _state.q[i].tail) {
                    uint32_t h = _state.q[i].head;
                    openclicknp::flit_t out = _state.q[i].wrs[h].f;
                    bool was_sop = _state.q[i].wrs[h].is_sop != 0;
                    bool was_eop = _state.q[i].wrs[h].is_eop != 0;
                    if (was_sop) {
                        openurma::ub_meta m{out};
                        uint8_t taop = m.ta_opcode();
                        if (taop == openurma::TAOP_READ
                            || (taop >= openurma::TAOP_ATOMIC_CAS
                             && taop <= openurma::TAOP_ATOMIC_FXOR)) {
                            _state.q[i].outstanding_read_atomic++;
                        }
                    }
                    _state.q[i].wrs[h].valid = 0;
                    _state.q[i].head = (h + 1) % _state.QUEUE_DEPTH;
                    set_output_port(1, out);
                    if (was_eop) {
                        _state.drain_in_packet = 0;
                        _state.drain_active_ini = -1;
                        if (_state.use_drr && _state.q[i].head == _state.q[i].tail) {
                            _state.deficit[i] = 0;
                            _state.drr_visit_active = 0;
                            _state.rr_cursor = (i + 1) & _state.INI_MASK;
                        }
                    }
                }
            }
        }
        return PORT_ALL;
    }
}
