    // Included in Layer. No graph construction, Send ordering or Ready gate lives here.
    void SetupHybrid(const std::string& out){
        Require(strategy==2&&jettyMode=="pair"&&n<=64&&segment<=4096,"hybrid requires unchanged CS graph and native pair resources");
        hybrid.Initialize(transfers.size());hybrid.offset=[this](uint32_t task,uint32_t ssn){return transfers.at(task).segmentOffsets.at(ssn);};hybrid.diagnostic=&diagnostic;
        std::set<uint32_t> relayExperts;for(auto&x:transfers)if(x.stage==2&&P(x.sourcePhysical).replica)relayExperts.insert(P(x.physical).expert);
        using Key=std::tuple<uint32_t,uint32_t,uint32_t,uint32_t,uint32_t,csmc::Role,std::vector<uint32_t>>;
        std::map<Key,size_t> index;struct Spec{Key key;std::vector<csmc::Manager::Member> members;};std::vector<Spec> specs;
        for(uint32_t task=2*assignments.size();task<transfers.size();++task){auto&x=transfers[task];auto expert=P(x.physical).expert;Require(x.stage==2&&x.source!=x.target&&P(x.sourcePhysical).expert==expert&&P(x.sourcePhysical).rank==x.source,"hybrid graph identity");
            Require(std::is_sorted(x.dependencies.begin(),x.dependencies.end())&&std::adjacent_find(x.dependencies.begin(),x.dependencies.end())==x.dependencies.end(),"hybrid canonical dependencies");
            const auto role=P(x.sourcePhysical).replica?csmc::Role::Stage2:relayExperts.count(expert)?csmc::Role::Stage1:csmc::Role::DirectFallback;
            Key key{x.source,x.sourcePhysical,expert,x.offset,x.bytes,role,x.dependencies};auto [it,fresh]=index.emplace(key,specs.size());if(fresh)specs.push_back({key,{}});
            auto tx=Ctrl(x.source)->GetTransportChannelManager()->GetTp(Tpn(x.source,x.target));auto rx=Ctrl(x.target)->GetTransportChannelManager()->GetTp(Tpn(x.target,x.source));Require(tx&&rx&&x.jettyId==Tpn(x.source,x.target),"hybrid persistent native pair binding");specs[it->second].members.push_back({x.target,task,tx,rx});
        }
        for(auto&s:specs){auto&[source,physical,expert,offset,bytes,role,deps]=s.key;hybrid.Add(source,physical,expert,offset,bytes,segment,role,deps,DynamicCast<UbPort>(nodes[source]->GetDevice(0)),std::move(s.members));}
        std::vector<uint32_t> ports;for(uint32_t i=0;i<n;++i)ports.push_back(i);auto fabric=nodes[n]->GetObject<UbSwitch>();fabric->EnableNetworkReplication(ports);
        for(uint32_t source=0;source<n;++source)if(hybrid.HasSource(source)){std::vector<Ptr<UbTransportChannel>> channels;for(uint32_t target=0;target<n;++target)if(source!=target){auto tp=Ctrl(source)->GetTransportChannelManager()->GetTp(Tpn(source,target));if(tp)channels.push_back(tp);}auto port=DynamicCast<UbPort>(nodes[source]->GetDevice(0));hybrid.InstallSource(source,port,channels,fabric);port->SetReceiveHandler(Callback<void,Ptr<UbPort>,Ptr<Packet>>([this,source](Ptr<UbPort> p,Ptr<Packet> packet){hybrid.Receive(source,p,packet);}));}
        hybrid.CheckCapacity(nodes);
        if(hybrid.alignHold){
            candidateHolds.open(out+"/candidate-holds.csv");Require(bool(candidateHolds),"candidate evidence output");
            candidateHolds<<"time_ps,event,reason,source,target,tp,group,selected_task,selected_ssn,selected_offset,selected_length,hold_generation,hold_active,hold_spent,armed_ps,deadline_ps,released_ps,member_rank,expected_task,submitted,consumed_bytes,head_task,head_kind,head_opcode,head_full_ssn,head_offset,head_bytes,cnp,ack,gbn,native_limited,inflight_limited,priority_data_eligibility_unknown\n";
            hybrid.holdTrace=[this](csmc::Proxy&p,const csmc::Manager::Choice&c,const char*event,const char*reason){CandidateSnapshot(p,c,event,reason);};
        }
        if(invalidateGrant){Require(!hybrid.groups.empty(),"hybrid stale grant test requires weights");auto&g=hybrid.groups.front();hybrid.pairs.at({g.source,g.members.front().rank})->invalidateOnce=true;}
        if(logLevel=="events"||logLevel=="debug"){weightWire.open(out+"/weight-packets.csv");weightWire<<"time_ps,node,port,kind,task,src_tpn,dst_tpn,psn,ssn,payload_bytes,wire_bytes\n";}
        Require(networkFaultRole=="any"||networkFaultRole=="stage1"||networkFaultRole=="stage2"||networkFaultRole=="direct-fallback","hybrid fault role");
        uint32_t faultGroup=0,faultMember=0;
        if(networkFaultTask!=UINT32_MAX){Require(networkFaultTask<hybrid.taskIndex.size()&&hybrid.taskIndex[networkFaultTask].group,"hybrid fault task");auto ref=hybrid.taskIndex[networkFaultTask];faultGroup=ref.group;faultMember=ref.member;Require(networkFaultRole=="any"||networkFaultRole==csmc::RoleName(hybrid.G(faultGroup).role),"hybrid fault task/role disagreement");}
        else {for(auto&g:hybrid.groups)if((networkFaultRole=="any"||networkFaultRole==csmc::RoleName(g.role))&&g.members.size()>1){faultGroup=g.id;break;}if(!faultGroup)for(auto&g:hybrid.groups)if(networkFaultRole=="any"||networkFaultRole==csmc::RoleName(g.role)){faultGroup=g.id;break;}}
        if(logLevel=="events"||logLevel=="debug"){
            hybridEvents.open(out+"/hybrid-events.csv");hybridEvents<<"time_ps,kind,group,task,offset,bytes,sequence,fanout,reason\n";
            hybridPhysical.open(out+"/hybrid-physical.csv");hybridPhysical<<"time_ps,event,node,port,kind,group,sequence,task,source,target,offset,payload_bytes,wire_bytes,psn,ssn,uid\n";
            hybrid.pulled=[this](const csmc::Manager::Choice&c,Ptr<Packet> p,bool retry){if(!c.group&&!retry)return;uint32_t group=c.group,task=UINT32_MAX,off=c.offset,len=c.length,seq=UINT32_MAX,fanout=1;if(group){auto&g=hybrid.G(group);task=g.members[c.member].task;fanout=g.members.size();if(c.merge)seq=g.codec->sequence-1;}else{UbTransportChannel::ReceivedDataPacketContext ctx;if(!packetParser->ParseReceivedDataPacketForTest(p->Copy(),ctx))return;task=ctx.flowTag.GetFlowId();if(task>=hybrid.taskIndex.size()||!hybrid.taskIndex[task].group)return;group=hybrid.taskIndex[task].group;off=HybridWireOffset(task,ctx.transactionHeader.GetIniTaSsn());len=ctx.payloadBytes;}HybridTraceBound();hybridEvents<<Simulator::Now().GetPicoSeconds()<<','<<(retry?"retry":c.merge?"envelope":"native_first")<<','<<group<<','<<task<<','<<off<<','<<len<<','<<seq<<','<<fanout<<','<<(retry?"native_retry":csmc::ReasonName(c.reason))<<'\n';};
        }
        hybrid.observe=[this,faultGroup,faultMember](uint32_t,uint32_t source,Ptr<Packet> packet,bool retry){
            if(!weightWire.is_open()&&networkFault.empty())return;UbTransportChannel::ReceivedDataPacketContext c;Require(packetParser->ParseReceivedDataPacketForTest(packet->Copy(),c),"hybrid native packet observation");auto task=c.flowTag.GetFlowId();
            if(!networkFault.empty()&&!retry&&task==hybrid.G(faultGroup).members[faultMember].task){auto&x=transfers.at(task);if(HybridWireOffset(task,c.transactionHeader.GetIniTaSsn())+c.payloadBytes==x.bytes)faultAckPsn=c.transportHeader.GetPsn();}
            WeightPacket(retry?"native_retry":"first_native",source,0,packet);
        };
        if(!networkFault.empty()){
            Require(weightBytes<=1024*1024&&faultGroup,"bounded hybrid native fault only");auto member=hybrid.G(faultGroup).members[faultMember];
            for(auto node:nodes)node->GetObject<UbSwitch>()->transportDeliveryFaultForTest=Callback<uint32_t,Ptr<Packet>>([this,member,nodeId=node->GetId()](Ptr<Packet> packet){
                if(faultInjected)return 1;auto p=packet->Copy();UbDatalinkPacketHeader dl;UbIpBasedNetworkHeader net;Ipv4Header ip;UdpHeader udp;UbTransportHeader tp;p->RemoveHeader(dl);p->RemoveHeader(net);p->RemoveHeader(ip);p->RemoveHeader(udp);p->RemoveHeader(tp);UbFlowTag tag;packet->PeekPacketTag(tag);if(tag.GetFlowId()!=member.task)return 1;
                bool match=false;
                if((networkFault=="data-once"||networkFault=="duplicate-once")&&tp.GetDestTpn()==member.rx->GetTpn()&&!UbTransportChannel::IsTransportResponseOpcode(tp.GetTPOpcode())){UbTransportChannel::ReceivedDataPacketContext c;Require(packetParser->ParseReceivedDataPacketForTest(packet->Copy(),c),"hybrid fault data decode");auto&x=transfers[member.task];auto off=HybridWireOffset(member.task,c.transactionHeader.GetIniTaSsn());match=off+c.payloadBytes==x.bytes&&c.transactionHeader.GetUbTransactionOpcode()==uint8_t(UbTransactionOpcode::WRITE);}
                if(networkFault=="ack-once"&&tp.GetDestTpn()==member.tx->GetTpn()&&UbTransportChannel::IsTransportResponseOpcode(tp.GetTPOpcode()))match=faultAckPsn!=UINT32_MAX&&tp.GetPsn()==faultAckPsn&&tp.GetLastPacket();
                if(networkFault=="taack-once"&&tp.GetDestTpn()==member.tx->GetTpn()&&!UbTransportChannel::IsTransportResponseOpcode(tp.GetTPOpcode())){UbTransportChannel::ReceivedDataPacketContext c;Require(packetParser->ParseReceivedDataPacketForTest(packet->Copy(),c),"hybrid fault TAACK decode");auto&x=transfers[member.task];auto off=HybridWireOffset(member.task,c.transactionHeader.GetIniTaSsn());match=c.transactionHeader.GetUbTransactionOpcode()==uint8_t(UbTransactionOpcode::TAACK)&&off+std::min(segment,x.bytes-off)==x.bytes;}
                if(match){faultInjected=true;++networkFaultCount;WeightPacket(networkFault=="duplicate-once"?"duplicate":"drop",nodeId,0,packet);return networkFault=="duplicate-once"?2:0;}return 1;
            });
        }
    }
    // Metadata only, no packet debug, extra simulator events, or policy callbacks.
    // Snapshot reads never call native IsLimited/CC. native_limited=-1 means unknown.
    void CandidateSnapshot(csmc::Proxy&p,const csmc::Manager::Choice&c,const char*event,const char*reason){
        if(std::string(event)=="pull"){
            ++candidatePullSeen;const std::string key=std::string(c.group?csmc::RoleName(hybrid.G(c.group).role):"native")+":"+reason;
            if(candidateSamples[key]++>=32)return;++candidatePullSampled;
        }
        auto row=[&](Ptr<UbTransportChannel>tp,uint32_t rank,uint32_t expected,bool submitted,uint32_t consumed){
            Require(++candidateRows<=candidateTraceLimit,"candidate evidence cap exceeded; incomplete evidence");
            auto head=tp->PeekOriginalSegmentForAdapter();uint32_t task=UINT32_MAX,kind=UINT32_MAX,opcode=UINT32_MAX,ssn=UINT32_MAX,off=UINT32_MAX,bytes=0;
            if(head){task=head->GetTaskId();kind=uint32_t(head->GetSegmentKind());opcode=uint32_t(head->GetType());ssn=head->GetTaSsn();bytes=head->GetBytesLeft();if(head->GetSegmentKind()==UbTransactionSegmentKind::REQUEST&&task<transfers.size()){auto it=transfers[task].segmentOffsets.find(ssn);if(it!=transfers[task].segmentOffsets.end())off=it->second;}}
            auto&h=p.hold;const uint32_t selected=c.group?hybrid.G(c.group).members[c.member].task:UINT32_MAX;
            candidateHolds<<Simulator::Now().GetPicoSeconds()<<','<<event<<','<<reason<<','<<p.source<<','<<p.target<<','<<p.tp->GetTpn()<<','<<c.group<<','<<selected<<','<<c.logicalSsn<<','<<c.offset<<','<<c.length<<','<<h.generation<<','<<h.active<<','<<h.spent<<','<<h.armedPs<<','<<h.deadlinePs<<','<<h.releasedPs<<','<<rank<<','<<expected<<','<<submitted<<','<<consumed<<','<<task<<','<<kind<<','<<opcode<<','<<ssn<<','<<off<<','<<bytes<<','<<tp->m_cnpQ.size()<<','<<tp->m_ackQ.size()<<','<<(tp->GetRetransEnable()&&tp->HasPendingGbnRetransmissionForTest())<<','<<-1<<','<<tp->IsInflightLimited()<<','<<csmc::Manager::Priority(tp)<<'\n';
        };
        if(c.group)for(auto&m:hybrid.G(c.group).members)row(m.tx,m.rank,m.task,m.submitted,m.firstBytes);
        else row(p.tp,p.target,UINT32_MAX,false,0);
    }
    void WriteCandidate(const std::string&out){
        if(!hybrid.alignHold)return;candidateHolds.flush();Require(bool(candidateHolds),"candidate evidence write");
        std::ofstream f(out+"/candidate-summary.json");
        f<<"{\"status\":\"PASS\",\"policy\":\"query-triggered-one-shot-exact-original-head\",\"enabled\":true,\"hold_ps\":"<<csmc::Manager::holdPs<<",\"scope\":\"stage1-stage2-only\",\"priority_data_eligibility\":\"unknown-speculative-no-CC-probe\",\"unchanged_native_rr_policy\":true,\"identical_realized_grants_claimed\":false,\"diagnostic_query_counts_comparable\":false,\"armed\":"<<hybrid.holdsArmed<<",\"released\":"<<hybrid.holdsReleased<<",\"expired\":"<<hybrid.holdExpired<<",\"early_releases\":"<<hybrid.holdEarly<<",\"head_change_releases\":"<<hybrid.holdHeadChanged<<",\"priority_bypass_queries\":"<<hybrid.holdPriorityBypass<<",\"max_app_hold_ps\":"<<hybrid.maxHoldPs<<",\"held_heads_consumed\":"<<hybrid.heldHeadsConsumed<<",\"max_release_to_consume_ps\":"<<hybrid.maxReleaseToConsumePs<<",\"active_holds\":"<<hybrid.activeHolds<<",\"peak_active_holds\":"<<hybrid.peakHolds<<",\"evidence_rows\":"<<candidateRows<<",\"evidence_cap\":"<<candidateTraceLimit<<",\"hold_ledger_complete\":true,\"pull_snapshot_limit_per_role_reason\":32,\"pull_decisions\":"<<candidatePullSeen<<",\"pull_decisions_sampled\":"<<candidatePullSampled<<",\"pull_decisions_omitted\":"<<candidatePullSeen-candidatePullSampled<<",\"actual_native_fallback_decomposition\":{";
        bool first=true;for(auto&entry:hybrid.holdFallback){f<<(first?"":",")<<'"'<<entry.first<<"\":"<<entry.second;first=false;}f<<"}}\n";Require(bool(f),"candidate summary write");
    }
    uint32_t HybridWireOffset(uint32_t task,uint32_t wireSsn){auto it=hybridWireSsns.find({task,uint16_t(wireSsn)});Require(it!=hybridWireSsns.end(),"hybrid trace/fault missing exact task wire SSN");return transfers.at(task).segmentOffsets.at(it->second);}
    void HybridTraceBound(){Require(++hybridTraceRows<=hybridTraceLimit,"hybrid physical/actual-pull evidence hard cap exceeded, incomplete evidence");}
    void HybridPhysical(const char* event,uint32_t node,uint32_t port,Ptr<Packet> packet){
        if(!hybridPhysical.is_open())return;
        uint32_t group=0,seq=UINT32_MAX,task=UINT32_MAX,source=UINT32_MAX,target=UINT32_MAX,off=0,len=0,psn=UINT32_MAX,ssn=UINT32_MAX;const char* kind="native_write";
        if(UbWriteV2::IsEnvelope(packet)){auto p=packet->Copy();UbDatalinkPacketHeader dl;p->RemoveHeader(dl);std::vector<uint8_t> bytes(p->GetSize());p->CopyData(bytes.data(),bytes.size());auto v=UbWriteV2::Decode(bytes);group=v.operation;seq=v.sequence;auto&g=hybrid.G(group);source=g.source;len=v.payload.size();kind="envelope";auto h=Create<Packet>(v.headers.front().data(),v.headers.front().size());UbIpBasedNetworkHeader net;Ipv4Header ip;UdpHeader udp;UbTransportHeader tp;UbTransactionHeader ta;h->RemoveHeader(net);h->RemoveHeader(ip);h->RemoveHeader(udp);h->RemoveHeader(tp);h->RemoveHeader(ta);ssn=ta.GetIniTaSsn();off=HybridWireOffset(g.members.front().task,ssn);}
        else {UbDatalinkHeader dl;packet->PeekHeader(dl);if(dl.GetConfig()!=3)return;UbFlowTag tag;if(!packet->PeekPacketTag(tag))return;task=tag.GetFlowId();if(task>=hybrid.taskIndex.size()||!hybrid.taskIndex[task].group)return;auto p=packet->Copy();UbDatalinkPacketHeader link;UbIpBasedNetworkHeader net;Ipv4Header ip;UdpHeader udp;UbTransportHeader tp;p->RemoveHeader(link);p->RemoveHeader(net);p->RemoveHeader(ip);p->RemoveHeader(udp);p->RemoveHeader(tp);group=hybrid.taskIndex[task].group;Require(tp.GetSrcTpn()&&tp.GetDestTpn(),"hybrid physical native TPN");source=(tp.GetSrcTpn()-1)/n;target=(tp.GetDestTpn()-1)/n;psn=tp.GetPsn();if(UbTransportChannel::IsTransportResponseOpcode(tp.GetTPOpcode())){kind="tpack";off=UINT32_MAX;}else{UbTransportChannel::ReceivedDataPacketContext c;if(!packetParser->ParseReceivedDataPacketForTest(packet->Copy(),c))return;auto opcode=c.transactionHeader.GetUbTransactionOpcode();if(opcode==uint8_t(UbTransactionOpcode::WRITE))kind="native_write";else if(opcode==uint8_t(UbTransactionOpcode::TAACK))kind="taack";else return;ssn=c.transactionHeader.GetIniTaSsn();off=HybridWireOffset(task,ssn);len=c.payloadBytes;}}
        HybridTraceBound();hybridPhysical<<Simulator::Now().GetPicoSeconds()<<','<<event<<','<<node<<','<<port<<','<<kind<<','<<group<<','<<seq<<','<<task<<','<<source<<','<<target<<','<<off<<','<<len<<','<<packet->GetSize()<<','<<psn<<','<<ssn<<','<<packet->GetUid()<<'\n';
    }
    void WriteHybrid(const std::string& out){
        Require(networkFault.empty()||faultInjected,"requested hybrid network fault never injected");
        struct Totals {uint64_t groups=0,multi=0,merged=0,envelopes=0,envPayload=0,envWire=0,branchPayload=0,branchWire=0,nativePackets=0,nativePayload=0,nativeWire=0,logicalPackets=0,logicalPayload=0,logicalWire=0;};
        Totals totals;std::array<Totals,3> byRole{};
        auto add=[](Totals&s,const csmc::Manager::Group&g){++s.groups;if(g.members.size()>1)++s.multi;if(g.envelopes)++s.merged;s.envelopes+=g.envelopes;s.envPayload+=g.envelopePayload;s.envWire+=g.envelopeWire;s.branchPayload+=g.branchPayload;s.branchWire+=g.branchWire;s.nativePackets+=g.nativePackets;s.nativePayload+=g.nativePayload;s.nativeWire+=g.nativeWire;auto packets=((uint64_t(g.bytes)+g.segment-1)/g.segment)*g.members.size();s.logicalPackets+=packets;s.logicalPayload+=uint64_t(g.bytes)*g.members.size();s.logicalWire+=uint64_t(g.bytes)*g.members.size()+78*packets;};
        std::ofstream members(out+"/hybrid-groups.csv");members<<"group,graph_role,expert,source,source_physical,offset,bytes,dependencies,task,target,physical,logical_ready_ps,native_submit_ps,first_send_ps,first_send_done_ps,first_send_bytes,receiver_ready_ps,sender_complete_ps,group_complete_ps\n";
        std::ofstream stats(out+"/hybrid-stats.csv");stats<<"group,graph_role,expert,source,source_physical,offset,bytes,fanout,logical_packets,logical_payload_bytes,envelopes,envelope_payload_bytes,envelope_wire_bytes,envelope_header_bytes,branch_payload_bytes,branch_wire_bytes,native_fallback_packets,native_fallback_payload_bytes,native_fallback_wire_bytes,association_limit,association_peak,association_restored,first_envelope_offset,last_envelope_end,group_complete_ps\n";
        for(auto&g:hybrid.groups){
            std::ostringstream deps;for(size_t i=0;i<g.dependencies.size();++i)deps<<(i?";":"")<<g.dependencies[i];
            for(auto&m:g.members){auto&x=transfers[m.task];members<<g.id<<','<<csmc::RoleName(g.role)<<','<<g.expert<<','<<g.source<<','<<g.sourcePhysical<<','<<g.globalOffset<<','<<g.bytes<<','<<deps.str()<<','<<m.task<<','<<m.rank<<','<<x.physical<<','<<taskAudit[m.task].send<<','<<m.submittedPs<<','<<m.firstPs<<','<<m.firstDonePs<<','<<m.firstBytes<<','<<taskAudit[m.task].finish<<','<<m.senderPs<<','<<g.completePs<<'\n';}
            stats<<g.id<<','<<csmc::RoleName(g.role)<<','<<g.expert<<','<<g.source<<','<<g.sourcePhysical<<','<<g.globalOffset<<','<<g.bytes<<','<<g.members.size()<<','<<((uint64_t(g.bytes)+g.segment-1)/g.segment)*g.members.size()<<','<<uint64_t(g.bytes)*g.members.size()<<','<<g.envelopes<<','<<g.envelopePayload<<','<<g.envelopeWire<<','<<g.envelopeHeaders<<','<<g.branchPayload<<','<<g.branchWire<<','<<g.nativePackets<<','<<g.nativePayload<<','<<g.nativeWire<<','<<g.associationCapacity<<','<<g.associationPeak<<','<<g.restored<<','<<(g.firstEnvelopeOffset==UINT64_MAX?0:g.firstEnvelopeOffset)<<','<<g.lastEnvelopeEnd<<','<<g.completePs<<'\n';add(totals,g);add(byRole[uint32_t(g.role)],g);
            Require(g.branchPayload+g.nativePayload==uint64_t(g.bytes)*g.members.size(),"hybrid logical member byte accounting");Require(g.restored==g.envelopes*g.members.size(),"hybrid restored member count");
        }
        auto json=[](std::ostream&f,const Totals&s){f<<"{\"groups\":"<<s.groups<<",\"multi_target_groups\":"<<s.multi<<",\"multicast_groups\":"<<s.merged<<",\"envelopes\":"<<s.envelopes<<",\"envelope_payload_bytes\":"<<s.envPayload<<",\"envelope_wire_bytes\":"<<s.envWire<<",\"branch_payload_bytes\":"<<s.branchPayload<<",\"branch_wire_bytes\":"<<s.branchWire<<",\"native_fallback_packets\":"<<s.nativePackets<<",\"native_fallback_payload_bytes\":"<<s.nativePayload<<",\"native_fallback_wire_bytes\":"<<s.nativeWire<<",\"original_first_send_packets\":"<<s.logicalPackets<<",\"original_first_send_bytes\":"<<s.logicalPayload<<",\"logical_native_wire_bytes\":"<<s.logicalWire<<",\"actual_source_wire_bytes\":"<<s.envWire+s.nativeWire<<'}';};
        std::ofstream summary(out+"/hybrid-summary.json");summary<<"{\"status\":\"PASS\",\"policy\":\"nonblocking-fixed-group-native-head\",\"graph_kind\":2,\"wire_codec\":\"unchanged-v2\",\"totals\":";json(summary,totals);summary<<",\"by_role\":{";for(uint32_t r=0;r<3;++r){summary<<(r?",":"")<<'\"'<<csmc::RoleName(csmc::Role(r))<<"\":";json(summary,byRole[r]);}summary<<"}}\n";
        std::ofstream fallback(out+"/hybrid-fallback.csv");fallback<<"graph_role,reason,packets,payload_bytes,wire_bytes\n";for(uint32_t r=0;r<3;++r)for(uint32_t why=1;why<uint32_t(csmc::Reason::Count);++why){auto&s=hybrid.fallback[r][why];fallback<<csmc::RoleName(csmc::Role(r))<<','<<csmc::ReasonName(csmc::Reason(why))<<','<<s.packets<<','<<s.payload<<','<<s.wire<<'\n';}
        auto fabric=nodes[n]->GetObject<UbSwitch>();auto replication=fabric->GetNetworkReplicationStats();Require(replication.admitted==totals.envelopes&&replication.released==totals.envelopes&&replication.branches==replication.branchDequeues&&!replication.parentBytes&&!replication.branchBytes&&!replication.descriptors,"hybrid switch replication drain/accounting");
        uint64_t invalidations=0;for(auto&[key,p]:hybrid.pairs)invalidations+=p->invalidatedGrants;Require(!invalidateGrant||invalidations==1,"hybrid stale grant injection missing");
        std::ofstream life(out+"/hybrid-lifecycle.json");life<<"{\"status\":\"PASS\",\"retry_counter_scope\":\"installed_hybrid_source_proxies\",\"all_native_pairs_safe\":true,\"pending_associations\":"<<hybrid.pendingAssociations<<",\"pending_members\":"<<hybrid.pendingMembers<<",\"active_codecs\":"<<hybrid.liveCodecs<<",\"max_live_codecs\":"<<hybrid.peakCodecs<<",\"allocated_codecs\":"<<hybrid.allocatedCodecs<<",\"retired_codecs\":"<<hybrid.retiredCodecs<<",\"max_pending_associations\":"<<hybrid.peakAssociations<<",\"max_pending_members\":"<<hybrid.peakPendingMembers<<",\"max_retained_association_capacity\":"<<hybrid.peakAssociationCapacity<<",\"max_rss_bytes\":"<<hybrid.peakRssBytes<<",\"descriptor_entries\":"<<hybrid.descriptorEntries<<",\"max_stage2_tasks\":"<<csmc::Manager::maxStage2Tasks<<",\"max_entries\":"<<csmc::Manager::maxEntries<<",\"rss_limit_bytes\":"<<csmc::Manager::maxRssBytes<<",\"native_retry_packets\":"<<hybrid.retries<<",\"native_retry_bytes\":"<<hybrid.retryBytes<<",\"weight_retry_packets\":"<<hybrid.retryWeightPackets<<",\"weight_retry_bytes\":"<<hybrid.retryWeightBytes<<",\"injected_losses\":"<<(networkFault=="duplicate-once"?0:networkFaultCount)<<",\"injected_duplicates\":"<<(networkFault=="duplicate-once"?networkFaultCount:0)<<",\"invalidated_grants\":"<<invalidations<<",\"pair_proxies\":"<<hybrid.pairs.size()<<",\"pair_jetties\":"<<pairJetties->Size()<<"}\n";
        hybridEvents.flush();hybridPhysical.flush();WriteCandidate(out);
        Require(bool(members)&&bool(stats)&&bool(summary)&&bool(fallback)&&bool(life),"hybrid output write");
    }
