+    void DoRun() override
+    {
+        Config::Reset();
+        LocalTpTopology topo = BuildLocalTpTopology();
+        InstallStaticTpPair(topo);
+        InstallAdditionalTpPair(topo, 303, 404);
+        InstallAdditionalTpPair(topo, 305, 406);
+        Ptr<UbController> controller = topo.sender->GetObject<UbController>();
+        Ptr<UbFunction> function = controller->GetUbFunction();
+        Ptr<UbTransaction> transaction = controller->GetUbTransaction();
+        const uint32_t first = kUrmaWriteRegressionSenderTpn;
+        // Intentionally bind out of order, mixing direct and shared-group users.
+        const std::vector<uint32_t> ids{71, 12, 90, 35, 66};
+        for (uint32_t id : ids)
+        {
+            function->CreateJetty(topo.sender->GetId(), topo.receiver->GetId(), id);
+        }
+        const auto bind = [&](uint32_t id, bool group, std::vector<uint32_t> tpns) {
+            NS_TEST_ASSERT_MSG_EQ(transaction->JettyBindTp(topo.sender->GetId(),
+                                                           topo.receiver->GetId(),
+                                                           id,
+                                                           group,
+                                                           tpns),
+                                  true,
+                                  "Reverse-index fixture binding should succeed");
+        };
+        bind(71, false, {first});
+        bind(12, true, {first, 303});
+        bind(90, true, {first, 303});
+        bind(35, false, {first});
+        bind(66, false, {305});
+        const auto check = [&]() {
+            for (uint32_t tpn : {first, 303u, 305u, UINT32_MAX})
+            {
+                std::vector<Ptr<UbJetty>> expected;
+                // Preserve the pre-index implementation as an independent candidate oracle.
+                for (uint32_t id : {12u, 35u, 66u, 71u, 90u})
+                {
+                    const auto transports = transaction->GetJettyLiveTps(id);
+                    const bool uses = std::any_of(
+                        transports.begin(), transports.end(),
+                        [tpn](const Ptr<UbTransportChannel>& tp) {
+                            return tp != nullptr && tp->GetTpn() == tpn;
+                        });
+                    Ptr<UbJetty> jetty = uses ? transaction->GetJetty(id) : nullptr;
+                    if (jetty != nullptr)
+                    {
+                        expected.push_back(jetty);
+                    }
+                }
+                const auto actual = transaction->GetJettiesUsingTpn(tpn);
+                NS_TEST_ASSERT_MSG_EQ(actual.size(), expected.size(),
+                                      "Indexed membership must match the old scan");
+                for (size_t i = 0; i < std::min(actual.size(), expected.size()); ++i)
+                {
+                    NS_TEST_ASSERT_MSG_EQ(actual[i], expected[i],
+                                          "Indexed results must preserve ascending Jetty order");
+                }
+            }
+        };
+        check();
+        const auto groupIdentity = transaction->FindRtpTransportReference(12)->GetIdentity();
+        Ptr<UbTransportGroup> group = controller->ResolveRtpTpGroup(groupIdentity);
+        const auto thirdIdentity = controller->GetTransportChannelManager()->GetTp(305)
+                                       ->GetLifecycleOwner();
+        NS_TEST_ASSERT_MSG_EQ(static_cast<uint32_t>(controller->AddRtpTpGroupMember(
+                                  groupIdentity, thirdIdentity)),
+                              static_cast<uint32_t>(UbTpgMemberMutationStatus::ADDED),
+                              "Dynamic addition should appear for every bound Jetty");
+        check();
+        group->MarkMemberRetiring(0);
+        group->FreezeNewOperations();
+        check(); // Retiring and frozen members remain visible while their TP is live.
+        group->ResumeNewOperations();
+        NS_TEST_ASSERT_MSG_EQ(static_cast<uint32_t>(controller->RemoveRtpTpGroupMember(
+                                  groupIdentity, thirdIdentity, UbDestroyReason::EXPLICIT)),
+                              static_cast<uint32_t>(UbTpgMemberMutationStatus::REMOVED),
+                              "Dynamic removal should disappear for every bound Jetty");
+        check();
+        bind(71, false, {305});
+        bind(35, true, {first, 303});
+        bind(90, false, {305});
+        check();
+        NS_TEST_ASSERT_MSG_EQ(transaction->JettyBindTp(topo.sender->GetId(),
+                                                       topo.receiver->GetId(), 71, false, {}),
+                              false, "Failed rebind must retain the old index entry");
+        check();
+        transaction->DestroyJettyTpMap(66);
+        transaction->DestroyJettyTpMap(66);
+        check();
+        NS_TEST_ASSERT_MSG_EQ(static_cast<uint32_t>(function->DestroyJetty(71)),
+                              static_cast<uint32_t>(UbDestroyStatus::COMPLETED),
+                              "Jetty destruction should erase its index entry");
+        function->CreateJetty(topo.sender->GetId(), topo.receiver->GetId(), 71);
+        bind(71, false, {first});
+        check();
+        NS_TEST_ASSERT_MSG_EQ(static_cast<uint32_t>(controller->DestroyRtpTpGroup(groupIdentity)),
+                              static_cast<uint32_t>(UbDestroyStatus::COMPLETED),
+                              "Group destruction should erase shared reverse bindings");
+        check();
+        bind(12, false, {303});
+        Ptr<UbTransportChannelManager> manager = controller->GetTransportChannelManager();
+        const auto oldIdentity = manager->GetTp(303)->GetLifecycleOwner();
+        NS_TEST_ASSERT_MSG_EQ(static_cast<uint32_t>(manager->DestroyTp(303)),
+                              static_cast<uint32_t>(UbDestroyStatus::PENDING),
+                              "Bound endpoint should drain until its reference is released");
+        check(); // Draining endpoints must disappear even while candidates remain indexed.
+        transaction->ReleaseCompletedJettyTransportBinding(12, false);
+        NS_TEST_ASSERT_MSG_EQ(manager->Contains(303), false,
+                              "Releasing the last direct binding should finalize endpoint drain");
+        check();
+        NS_TEST_ASSERT_MSG_EQ(manager->CreateTp(topo.sender->GetId(), topo.receiver->GetId(),
+                                                topo.senderPort->GetIfIndex(),
+                                                topo.receiverPort->GetIfIndex(),
+                                                kUrmaWriteRegressionPriority, 303, 404,
+                                                UbCongestionControl::Create(UB_DEVICE)),
+                              true, "Endpoint number should be reusable");
+        NS_TEST_ASSERT_MSG_NE(manager->GetTp(303)->GetLifecycleOwner().generation,
+                              oldIdentity.generation, "Reused endpoint needs a new generation");
+        check(); // Endpoint reuse must not resurrect an erased Jetty binding.
+        bind(12, false, {303});
+        check();
+        Simulator::Destroy();
+        Config::Reset();
+    }
+};
