+        NS_TEST_ASSERT_MSG_EQ(m_pair.senderJetty->GetActiveWqeCount(), 0u, "no residual WQEs");
+        NS_TEST_ASSERT_MSG_EQ(m_pair.senderTp->GetOutstandingUnackedSegmentCount(), 0u,
