+void UbQueueManager::MoveProcessingToNetworkBranches(uint32_t inPort, uint32_t firstOut,
+    uint32_t priority, uint32_t bytes, const std::vector<uint32_t>& outputs)
+{
+    NS_ABORT_MSG_IF(outputs.empty() || outputs.front() != firstOut, "Invalid branch outputs");
+    MoveInPortProcessingToVoq(inPort, firstOut, priority, bytes);
+    for (size_t i=1; i<outputs.size(); ++i) {
+        m_outPortBuffer[outputs[i]][priority] += bytes;
+        m_totalOutPortVoqBufferedBytes[outputs[i]] += bytes;
+        m_traceOutPortBufferBytes(outputs[i], GetTotalOutPortBufferUsed(outputs[i]));
+    }
+}
+
+void UbQueueManager::PopNetworkBranch(uint32_t inPort, uint32_t outPort,
+    uint32_t priority, uint32_t bytes, bool last)
+{
+    NS_ABORT_MSG_IF(m_outPortBuffer[outPort][priority] < bytes ||
+        m_totalOutPortVoqBufferedBytes[outPort] < bytes, "Network branch accounting underflow");
+    m_outPortBuffer[outPort][priority] -= bytes;
+    m_totalOutPortVoqBufferedBytes[outPort] -= bytes;
+    if (last) {
+        NS_ABORT_MSG_IF(m_totalVoqBufferedBytes < bytes, "Network parent accounting underflow");
+        m_totalVoqBufferedBytes -= bytes;
+        RemoveFromIngressAdmission(inPort, priority, bytes);
+        m_traceIngressQueueOccupancyBytes(inPort, priority, GetQueueIngressTotalBytes(inPort, priority));
+    }
+    m_traceOutPortBufferBytes(outPort, GetTotalOutPortBufferUsed(outPort));
+}
