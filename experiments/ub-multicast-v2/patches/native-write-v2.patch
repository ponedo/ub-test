+void UbSwitch::SetWriteV2MetadataResolver(uint32_t inPort,
+    Callback<void, uint32_t, uint32_t, uint32_t, Ptr<Packet>> resolver)
+{
+    NS_ABORT_MSG_IF(GetNodeType()!=UB_SWITCH || inPort>=m_portsNum || resolver.IsNull() ||
+                    m_writeV2Resolvers.count(inPort), "invalid/duplicate v2 resolver");
+    m_writeV2Resolvers.emplace(inPort,resolver);
+}
+bool UbSwitch::HandleWriteV2(Ptr<UbPort> port, Ptr<Packet> packet)
+{
+    if (!UbWriteV2::IsEnvelope(packet)) return false;
+    const auto in=port->GetIfIndex();
+    NS_ABORT_MSG_IF(GetNodeType()!=UB_SWITCH || !IsCBFCEnable() || !m_writeV2Resolvers.count(in),
+                    "v2 requires one configured CBFC switch");
+    auto raw=packet->Copy(); UbDatalinkPacketHeader outer; raw->RemoveHeader(outer);
+    auto priority=outer.GetPacketVL();
+    NS_ABORT_MSG_IF(!priority || priority>=m_vlNum,"v2 priority");
+    std::vector<uint8_t> bytes(raw->GetSize()); raw->CopyData(bytes.data(),bytes.size());
+    UbWriteV2 envelope;
+    try { envelope=UbWriteV2::Decode(bytes); }
+    catch(const std::exception& e) { NS_ABORT_MSG("invalid v2 envelope: " << e.what()); }
+    // Consume this input hop's piggyback exactly once; reconstructed DL has no credit.
+    port->GetFlowControl()->OnDataPacketReceived(packet);
+    auto sharedPayload=Create<Packet>(envelope.payload.data(),envelope.payload.size());
+    std::vector<uint32_t> outputs,ranks; std::vector<Ptr<Packet>> branches; uint64_t mask=0;
+    for (size_t i=0;i<envelope.headers.size();++i) {
+        auto& h=envelope.headers[i]; auto branch=Create<Packet>(h.data(),h.size());
+        branch->AddAtEnd(sharedPayload);
+        UbDatalinkPacketHeader dl=outer; dl.SetCredit(false); dl.SetACK(false);
+        dl.SetConfig(static_cast<uint8_t>(UbDatalinkHeaderConfig::PACKET_IPV4)); branch->AddHeader(dl);
+        // The resolver may restore tags only. Neither header nor payload comes from it.
+        std::vector<uint8_t> before(branch->GetSize()); branch->CopyData(before.data(),before.size());
+        m_writeV2Resolvers.at(in)(envelope.operation,envelope.sequence,i,branch);
+        std::vector<uint8_t> after(branch->GetSize()); branch->CopyData(after.data(),after.size());
+        NS_ABORT_MSG_IF(before!=after,"v2 resolver changed wire bytes");
+        ParsedURMAHeaders parsed; ParseURMAPacketHeader(branch,parsed);
+        RoutingKey key; bool shortest=false;
+        int output=ResolveURMAOutput(branch,parsed,in,key,shortest);
+        NS_ABORT_MSG_IF(output<0 || uint32_t(output)==in || output>=64 ||
+                        (mask & (uint64_t{1}<<output)),"v2 missing/reflected/shared output route");
+        UintegerValue limit; DynamicCast<UbPort>(GetObject<Node>()->GetDevice(output))->GetUbQueue()->
+            GetAttribute("MaxEgressBytes",limit);
+        NS_ABORT_MSG_IF(branch->GetSize()>limit.Get(),"v2 native branch exceeds finite egress");
+        mask|=uint64_t{1}<<output; outputs.push_back(output); ranks.push_back(i); branches.push_back(branch);
+        LastPacketTraversesNotify(GetObject<Node>()->GetId(),parsed.transportHeader);
+    }
+    uint32_t inputBytes=packet->GetSize();
+    NS_ABORT_MSG_IF(!m_queueManager->CheckInPortSpace(in,priority,inputBytes),"v2 ingress capacity");
+    NS_ABORT_MSG_IF(m_nextNetworkParent==UINT64_MAX,"v2 parent exhausted");
+    auto id=m_nextNetworkParent++;
+    m_queueManager->PushToInPortProcessing(in,outputs.front(),priority,inputBytes);
+    m_networkParents.emplace(id,NetworkParent{in,priority,inputBytes,mask,0,packet,outputs,ranks,branches});
+    ++m_networkStats.admitted; m_networkStats.parentBytes+=inputBytes;
+    m_networkStats.peakParentBytes=std::max(m_networkStats.peakParentBytes,m_networkStats.parentBytes);
+    m_networkStats.descriptors+=outputs.size();
+    m_networkStats.peakDescriptors=std::max(m_networkStats.peakDescriptors,m_networkStats.descriptors);
+    if(m_inPortProcessingDelay<=NanoSeconds(0)) CompleteNetworkProcessing(id);
+    else m_networkEvents.push_back(Simulator::Schedule(m_inPortProcessingDelay,&UbSwitch::CompleteNetworkProcessing,this,id));
+    return true;
+}
+}
