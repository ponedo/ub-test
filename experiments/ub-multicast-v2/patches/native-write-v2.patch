diff --git a/src/unified-bus/model/ub-write-v2.h b/src/unified-bus/model/ub-write-v2.h
new file mode 100644
index 0000000..ee6f01c
--- /dev/null
+++ b/src/unified-bus/model/ub-write-v2.h
@@ -0,0 +1,81 @@
+// SPDX-License-Identifier: GPL-2.0-only
+#ifndef UB_WRITE_V2_H
+#define UB_WRITE_V2_H
+#include "ns3/packet.h"
+#include "ns3/ipv4-header.h"
+#include "ns3/udp-header.h"
+#include "ns3/ub-header.h"
+#include "ns3/ub-ta-codec.h"
+#include <vector>
+#include <set>
+#include <stdexcept>
+namespace ns3 {
+// Experimental single-switch WRITE envelope. No PacketTag serialization.
+struct UbWriteV2 {
+    static constexpr uint32_t MAGIC = 0x55425732; // UBW2; distinct from v1 oracle magic
+    uint32_t operation{}, sequence{};
+    std::vector<std::vector<uint8_t>> headers;
+    std::vector<uint8_t> payload;
+    static void Check(bool ok, const char* what) { if (!ok) throw std::runtime_error(what); }
+    static void Put(std::vector<uint8_t>& b, uint32_t v, unsigned n) {
+        for (unsigned i=n; i; --i) b.push_back(v >> (8*(i-1)));
+    }
+    static uint32_t Take(const std::vector<uint8_t>& b, size_t& at, unsigned n) {
+        Check(at <= b.size() && n <= b.size()-at, "truncated v2");
+        uint32_t v=0; while(n--) v=(v<<8)|b[at++]; return v;
+    }
+    // Validate the native header using the native rule and header codecs. No tags used.
+    static uint32_t Destination(const std::vector<uint8_t>& h, uint32_t payloadBytes) {
+        Check(h.size()>=74 && h.size()<=65535, "native header length");
+        Check((h[6]>>4)==4 && (h[6]&15)==5, "v2 requires native IPv4 without options");
+        auto p=Create<Packet>(h.data(),h.size());
+        UbIpBasedNetworkHeader net; Ipv4Header ip; UdpHeader udp;
+        UbTransportHeader tp; UbTransactionHeader ta;
+        p->RemoveHeader(net); p->RemoveHeader(ip); p->RemoveHeader(udp);
+        p->RemoveHeader(tp); p->RemoveHeader(ta);
+        Check(ip.GetProtocol()==17 && size_t(ip.GetPayloadSize())+20==h.size()-6+payloadBytes,
+              "native IP length/protocol");
+        Check(tp.GetTPOpcode()==1 && ta.GetUbTransactionOpcode()==uint8_t(UbTransactionOpcode::WRITE),
+              "v2 supports WRITE request only");
+        Check(!ta.GetTvEn() && !ta.GetMtEn(), "unsupported WRITE flags");
+        auto plan=UbTaHeaderPlan::ForRequest(*FindTransactionRule(UbTransactionOpcode::WRITE),
+                                            {false,false,ta.GetUdFlg()});
+        Check(p->GetSize()==plan.GetExtensionBytes(16), "WRITE header plan length");
+        return ip.GetDestination().Get();
+    }
+    void Validate() const {
+        Check(!headers.empty() && headers.size()<=64, "v2 member count");
+        Check(!payload.empty() && payload.size()<=4096, "v2 payload bound");
+        std::set<uint32_t> destinations;
+        for(auto& h:headers) Check(destinations.insert(Destination(h,payload.size())).second,
+                                  "duplicate v2 destination");
+    }
+    std::vector<uint8_t> Encode() const {
+        Validate(); std::vector<uint8_t> b;
+        Put(b,MAGIC,4); Put(b,2,1); Put(b,0,1); Put(b,headers.size(),2);
+        Put(b,operation,4); Put(b,sequence,4); Put(b,payload.size(),4);
+        for(auto& h:headers) Put(b,h.size(),2);
+        for(auto& h:headers) b.insert(b.end(),h.begin(),h.end());
+        b.insert(b.end(),payload.begin(),payload.end()); return b;
+    }
+    static UbWriteV2 Decode(const std::vector<uint8_t>& b) {
+        size_t at=0; Check(Take(b,at,4)==MAGIC,"v2 magic/type");
+        Check(Take(b,at,1)==2 && Take(b,at,1)==0,"v2 version/flags");
+        auto count=Take(b,at,2); Check(count && count<=64,"v2 member count");
+        UbWriteV2 v; v.operation=Take(b,at,4); v.sequence=Take(b,at,4);
+        auto len=Take(b,at,4); Check(len && len<=4096,"v2 payload bound");
+        std::vector<uint32_t> sizes; size_t total=0;
+        for(unsigned i=0;i<count;++i) { auto n=Take(b,at,2); Check(n>=74,"v2 header length"); sizes.push_back(n); total+=n; }
+        Check(total+len==b.size()-at,"v2 total length");
+        for(auto n:sizes) { v.headers.emplace_back(b.begin()+at,b.begin()+at+n); at+=n; }
+        v.payload.assign(b.begin()+at,b.end()); v.Validate(); return v;
+    }
+    static bool IsEnvelope(Ptr<const Packet> p) {
+        if(p->GetSize()<4) return false;
+        uint8_t b[4]; p->CopyData(b,4);
+        // Reserved experimental DL config, not an official UB protocol assignment.
+        return (b[1]&15)==15;
+    }
+};
+}
+#endif
