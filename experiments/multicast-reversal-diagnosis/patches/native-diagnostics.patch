+// SPDX-License-Identifier: GPL-2.0-only
+#ifndef UB_REVERSAL_DIAGNOSTIC_H
+#define UB_REVERSAL_DIAGNOSTIC_H
+#include "ns3/packet.h"
+#include <cstdint>
+namespace ns3 {
+enum class UbReversalDiagnosticKind : uint8_t {
+    VoqPush, VoqPop, AllocSelect, GrantStart, GrantCommit,
+    EgressEnqueue, EgressSend, PortBusyStart, PortBusyEnd, TxStart, Rx,
+    TpEnqueue, TpPop, TpHead, TpLimited, TpAckBefore, TpAckAfter,
+    TpResponseBefore, TpResponseAfter, EnvelopeDecode, NativeBranch, QueueBind, TpEmpty,
+    GrantRejected, GrantNoIngress
+};
+enum class UbReversalDiagnosticReason : uint8_t {
+    None, Empty, Ack, Cnp, Inflight, Cc, Eligible, Retransmission, Failed
+};
+// Semantic contract:
+// - QueueBind/AllocSelect: aux0=input port, aux1=priority. QueueBind precedes
+//   first push. Queue identities are only meaningful within one simulation.
+// - VoqPush/VoqPop: aux0=post-operation depth, aux1=input port, aux2=priority.
+//   Pop observes the removed front immediately before storage changes, after
+//   the existing non-empty assertion. Match per-queue FIFO enqueue occurrence;
+//   UID is only a consistency check because copies can share a UID.
+//   m_headArrivalTime is NOT enqueue residence time.
+// - GrantRejected: existing RR commit revalidation rejected the selected queue.
+//   GrantNoIngress: existing RR callback reached its no-selected-queue branch.
+//   Both carry node/port/queue/time only; match to the preceding GrantStart on
+//   the same port for measured elapsed time and its configured delay (aux0).
+//   Neither event alone identifies which short-circuit predicate rejected it.
+// - GrantStart: aux0=allocation delay ps. AllocSelect may repeat for an active
+//   queue; GrantCommit is an actual successful enqueue, not eligibility.
+// - EgressEnqueue/EgressSend: aux0=input port, aux1=priority.
+// - TxStart: successful link start; aux0=serialization+explicit delay ps,
+//   aux1=busy duration including IFG/NOB, aux2=explicit delay ps. Subtract
+//   aux2 for pure serialized-wire time. aux3=1 marks detached transmission.
+// - Rx: actual port receive callback, before switch dispatch/header removal.
+// - TP enqueue/pop/head/limited/ACK: aux0=sndNxt, aux1=sndUna,
+//   aux2=maxInflightPacketSize, aux3=existing sendWindowLimited state flag.
+//   This flag can be stale: only TpLimited.reason records the tested branch.
+//   ACK/CNP queue bypass is not congestion permission for new data. TpPop
+//   observes GetNextPacket's result; null means no packet, not a departure.
+//   TpEnqueue without packet is a WQE segment, not a serialized packet.
+//   TpHead records existing scheduler head timestamp assignments, NOT a new
+//   packet's physical enqueue time or a computed HOL-block duration.
+// - TpEmpty: aux0=existing result, aux1=sndNxt, aux2=sndUna, aux3=tpPsnCnt.
+// - TpResponseBefore/After brackets RecvDataPacket (all data including TA
+//   responses), aux0=sndNxt, aux1=sndUna, aux2=recvNxt, aux3=maxRcvPsn.
+//   TpAckBefore/After brackets all RecvTpAck exits, including CNP/NAK/ignored
+//   responses. Packet may have headers removed by the existing receive path.
+// - EnvelopeDecode: aux0=operation, aux1=sequence, aux2=branch count.
+// - NativeBranch: packet=new native packet; aux0=parent envelope UID,
+//   aux1=operation, aux2=sequence, aux3=branch index. No tag mutation is added.
+// Source-flight caution: sndNxt-sndUna counts sequence-space outstanding work,
+// not bytes physically on a source link. WQE admission, first TP generation,
+// allocator commit, port busy time, serialized TX and actual RX are separate.
+// Observations neither schedule work nor add protocol/CC/retransmission probes.
+// Observation only. The sink must not mutate packets/model state or schedule events.
+// queue is a process-local identity, not a stable identifier across runs.
+struct UbReversalDiagnosticEvent {
+    int64_t timePs = 0;
+    UbReversalDiagnosticKind kind = UbReversalDiagnosticKind::VoqPush;
+    UbReversalDiagnosticReason reason = UbReversalDiagnosticReason::None;
+    uint32_t node = UINT32_MAX, port = UINT32_MAX, tp = UINT32_MAX;
+    uintptr_t queue = 0;
+    Ptr<const Packet> packet;
+    uint64_t aux0 = 0, aux1 = 0, aux2 = 0, aux3 = 0;
+};
+class UbReversalDiagnostic {
+public:
+    using Sink = void (*)(const UbReversalDiagnosticEvent&);
+    static void SetSink(Sink sink);
+    static bool Enabled();
+    static void Emit(UbReversalDiagnosticEvent event);
+private:
+    static Sink m_sink;
+};
+} // namespace ns3
+#endif
