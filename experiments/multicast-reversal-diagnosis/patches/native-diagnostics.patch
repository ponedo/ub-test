+// SPDX-License-Identifier: GPL-2.0-only
+#include "ub-reversal-diagnostic.h"
+#include "ns3/simulator.h"
+namespace ns3 {
+UbReversalDiagnostic::Sink UbReversalDiagnostic::m_sink = nullptr;
+void UbReversalDiagnostic::SetSink(Sink sink) { m_sink = sink; }
+bool UbReversalDiagnostic::Enabled() { return m_sink != nullptr; }
+void UbReversalDiagnostic::Emit(UbReversalDiagnosticEvent event)
+{
+    if (m_sink) {
+        event.timePs = Simulator::Now().GetPicoSeconds();
+        m_sink(event);
+    }
+}
+} // namespace ns3
