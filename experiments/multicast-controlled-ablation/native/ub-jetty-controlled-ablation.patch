+void
+UbJetty::ObserveJetty(UbReversalDiagnosticKind kind,
+                       uint32_t taSsn,
+                       UbReversalDiagnosticReason reason,
+                       uint32_t task) const
+{
+    if (UbReversalDiagnostic::Enabled())
+    {
+        UbReversalDiagnostic::Emit({.kind = kind,
+            .reason = reason,
+            .node = m_src,
+            .port = m_dest,
+            .tp = m_jettyNum,
+            .queue = reinterpret_cast<uintptr_t>(this),
+            .aux0 = m_taSsnSndNxt,
+            .aux1 = m_taSsnSndUna,
+            .aux2 = m_inflightMax,
+            .aux3 = taSsn,
+            .task = task});
+    }
+}
+
+bool
+UbJetty::IsLimited()
+{
+    const bool limited = (m_taSsnSndNxt - m_taSsnSndUna) >= m_inflightMax;
+    ObserveJetty(UbReversalDiagnosticKind::JettyWindowTest, UINT32_MAX,
+                 limited ? UbReversalDiagnosticReason::Inflight
+                         : UbReversalDiagnosticReason::Eligible);
+    return limited;
+}
