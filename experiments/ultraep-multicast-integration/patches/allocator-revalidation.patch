+// Type definitions are statically registered before objects in this simulator.
+// Cache presence, not the per-object getter value. Missing-attribute lookup
+// otherwise copies every attribute's metadata on every ordinary packet grant.
+bool
+NeedsCommitRevalidation(Ptr<UbIngressQueue> queue)
+{
+    if (queue == nullptr)
+    {
+        return false;
+    }
+    static std::map<uint16_t, bool> attributePresence;
+    const TypeId type = queue->GetInstanceTypeId();
+    auto it = attributePresence.find(type.GetUid());
+    if (it == attributePresence.end())
+    {
+        TypeId::AttributeInformation info;
+        const bool present = type.LookupAttributeByName("RevalidateOnCommit", &info);
+        it = attributePresence.emplace(type.GetUid(), present).first;
+    }
+    if (!it->second)
+    {
+        return false;
+    }
+    BooleanValue value(false);
+    return queue->GetAttributeFailSafe("RevalidateOnCommit", value) && value.Get();
+}
