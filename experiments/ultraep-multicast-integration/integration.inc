    void SetupMulticastV2(const std::string& out){
        multicastV2.submit=[this](uint32_t task){Send(task);if(fault=="duplicate-weight")Send(task);};
        multicastV2.offset=[this](uint32_t task,uint32_t ssn){return transfers.at(task).segmentOffsets.at(ssn);};
        for(uint32_t task=2*assignments.size();task<transfers.size();++task){auto&x=transfers[task];Require(x.offset==0&&x.bytes==weightBytes&&x.dependencies.empty()&&!P(x.sourcePhysical).replica&&x.source!=x.target,"v2 direct weight graph");multicastTasks[P(x.physical).expert+1].push_back(task);}
        std::vector<uint32_t> ports;for(uint32_t i=0;i<n;++i)ports.push_back(i);auto fabric=nodes[n]->GetObject<UbSwitch>();fabric->EnableNetworkReplication(ports);
        for(auto&[id,tasks]:multicastTasks){auto source=transfers[tasks.front()].source;std::vector<pairv2::Manager::Member> members;for(auto task:tasks){auto&x=transfers[task];Require(x.source==source,"v2 expert source");auto tx=Ctrl(source)->GetTransportChannelManager()->GetTp(Tpn(source,x.target));auto rx=Ctrl(x.target)->GetTransportChannelManager()->GetTp(Tpn(x.target,source));Require(tx&&rx&&x.jettyId==source*n+x.target+1,"v2 pair resource reuse");members.push_back({x.target,task,tx,rx});}multicastV2.Add(id,source,weightBytes,segment,DynamicCast<UbPort>(nodes[source]->GetDevice(0)),members);}
        for(uint32_t source=0;source<n;++source)if(multicastV2.HasSource(source)){std::vector<Ptr<UbTransportChannel>> channels;for(uint32_t target=0;target<n;++target)if(source!=target){auto tp=Ctrl(source)->GetTransportChannelManager()->GetTp(Tpn(source,target));if(tp)channels.push_back(tp);}auto port=DynamicCast<UbPort>(nodes[source]->GetDevice(0));multicastV2.InstallSource(source,port,channels,fabric);port->SetReceiveHandler(Callback<void,Ptr<UbPort>,Ptr<Packet>>([this,source](Ptr<UbPort> port,Ptr<Packet> p){multicastV2.Receive(source,port,p);}));}
        multicastV2.CheckCapacity(nodes);
        if(invalidateGrant){Require(!multicastV2.groups.empty(),"grant test requires weights");auto&g=multicastV2.groups.begin()->second;multicastV2.pairs.at({g.source,g.members.front().rank})->invalidateOnce=true;}
        if(logLevel=="events"){weightWire.open(out+"/weight-packets.csv");weightWire<<"time_ps,node,port,kind,task,src_tpn,dst_tpn,psn,ssn,payload_bytes,wire_bytes\n";}
        multicastV2.observe=[this](uint32_t group,uint32_t source,Ptr<Packet> p,bool retry){
            if(!weightWire.is_open()&&networkFault.empty())return;
            UbTransportChannel::ReceivedDataPacketContext c;Require(packetParser->ParseReceivedDataPacketForTest(p->Copy(),c),"native weight observation");auto task=c.flowTag.GetFlowId();
            if(!networkFault.empty()&&!retry&&task==multicastV2.groups.begin()->second.members.front().task){auto&x=transfers.at(task);if(x.segmentOffsets.at(c.transactionHeader.GetIniTaSsn())+c.payloadBytes==x.bytes)faultAckPsn=c.transportHeader.GetPsn();}
            WeightPacket(retry?"native_retry":"first_native",source,0,p);
        };
        if(!networkFault.empty()){
            Require(weightBytes<=1024*1024&&!multicastV2.groups.empty(),"bounded network fault only");auto&g=multicastV2.groups.begin()->second;auto member=g.members.front();auto source=g.source;
            for(auto node:nodes)node->GetObject<UbSwitch>()->transportDeliveryFaultForTest=Callback<uint32_t,Ptr<Packet>>([this,member,source,nodeId=node->GetId()](Ptr<Packet> packet){
                if(faultInjected)return 1;auto p=packet->Copy();UbDatalinkPacketHeader dl;UbIpBasedNetworkHeader net;Ipv4Header ip;UdpHeader udp;UbTransportHeader tp;p->RemoveHeader(dl);p->RemoveHeader(net);p->RemoveHeader(ip);p->RemoveHeader(udp);p->RemoveHeader(tp);UbFlowTag tag;packet->PeekPacketTag(tag);if(tag.GetFlowId()!=member.task)return 1;
                bool match=false;
                if(networkFault=="data-once"&&tp.GetDestTpn()==member.rx->GetTpn()&&!UbTransportChannel::IsTransportResponseOpcode(tp.GetTPOpcode())){UbTransportChannel::ReceivedDataPacketContext c;Require(packetParser->ParseReceivedDataPacketForTest(packet->Copy(),c),"fault decode");auto&x=transfers[member.task];auto i=x.segmentOffsets.find(c.transactionHeader.GetIniTaSsn());match=i!=x.segmentOffsets.end()&&i->second+c.payloadBytes==x.bytes&&c.transactionHeader.GetUbTransactionOpcode()==uint8_t(UbTransactionOpcode::WRITE);}
                if(networkFault=="ack-once"&&tp.GetDestTpn()==member.tx->GetTpn()&&UbTransportChannel::IsTransportResponseOpcode(tp.GetTPOpcode()))match=faultAckPsn!=UINT32_MAX&&tp.GetPsn()==faultAckPsn&&tp.GetLastPacket();
                if(match){faultInjected=true;++networkFaultCount;WeightPacket("drop",nodeId,0,packet);return 0;}return 1;
            });
        }
    }
    void WeightPacket(const std::string& kind,uint32_t node,uint32_t port,Ptr<Packet> packet){
        if(!weightWire.is_open())return;auto p=packet->Copy();UbDatalinkPacketHeader dl;UbIpBasedNetworkHeader net;Ipv4Header ip;UdpHeader udp;UbTransportHeader tp;p->RemoveHeader(dl);p->RemoveHeader(net);p->RemoveHeader(ip);p->RemoveHeader(udp);p->RemoveHeader(tp);UbFlowTag tag;packet->PeekPacketTag(tag);uint32_t ssn=0,payload=0;
        if(!UbTransportChannel::IsTransportResponseOpcode(tp.GetTPOpcode())){UbTransportChannel::ReceivedDataPacketContext c;Require(packetParser->ParseReceivedDataPacketForTest(packet->Copy(),c),"weight packet decode");ssn=c.transactionHeader.GetIniTaSsn();payload=c.payloadBytes;}
        weightWire<<Simulator::Now().GetPicoSeconds()<<','<<node<<','<<port<<','<<kind<<','<<tag.GetFlowId()<<','<<tp.GetSrcTpn()<<','<<tp.GetDestTpn()<<','<<tp.GetPsn()<<','<<ssn<<','<<payload<<','<<packet->GetSize()<<'\n';weightWire.flush();
    }
    void RecordPacket(uint32_t node,uint32_t port,Ptr<Packet> packet){
        if(UbWriteV2::IsEnvelope(packet)){portTxWire[{node,port}]+=packet->GetSize();auto&stat=packetStats[{node,port,"multicast_v2"}];++stat.first;stat.second+=packet->GetSize();if(weightWire.is_open())weightWire<<Simulator::Now().GetPicoSeconds()<<','<<node<<','<<port<<",envelope,0,0,0,0,0,0,"<<packet->GetSize()<<'\n';return;}
        RecordLegacyPacket(node,port,packet);
        if(weightWire.is_open()&&nodes[node]->GetObject<UbSwitch>()->GetPacketTypeForTest(packet)==UB_URMA_DATA_PACKET){auto copy=packet->Copy();UbDatalinkPacketHeader dl;UbIpBasedNetworkHeader net;Ipv4Header ip;UdpHeader udp;UbTransportHeader h;copy->RemoveHeader(dl);copy->RemoveHeader(net);copy->RemoveHeader(ip);copy->RemoveHeader(udp);copy->RemoveHeader(h);if(!UbTransportChannel::IsTransportResponseOpcode(h.GetTPOpcode())){UbTransportChannel::ReceivedDataPacketContext c;Require(packetParser->ParseReceivedDataPacketForTest(packet->Copy(),c),"weight trace parse");auto task=c.flowTag.GetFlowId();if(task<transfers.size()&&transfers[task].stage==2)weightWire<<Simulator::Now().GetPicoSeconds()<<','<<node<<','<<port<<",native,"<<task<<','<<h.GetSrcTpn()<<','<<h.GetDestTpn()<<','<<h.GetPsn()<<','<<c.transactionHeader.GetIniTaSsn()<<','<<c.payloadBytes<<','<<packet->GetSize()<<'\n';}}
    }
    void WriteMulticastV2(const std::string& out){
        Require(networkFault.empty()||faultInjected,"requested network fault never injected");
        std::ofstream groups(out+"/multicast-groups.csv");groups<<"group,expert,source,task,target,physical,bytes,receiver_ready_ps,sender_complete_ps,group_complete_ps\n";
        std::ofstream stats(out+"/multicast-stats.csv");stats<<"group,source,fanout,payload_bytes,wire_bytes,envelopes,native_singleton_packets,header_bytes,association_limit,association_peak,association_restored,first_send_grants,admitted_ps,first_send_done_ps\n";
        for(auto&[id,g]:multicastV2.groups){for(auto&m:g.members){auto&x=transfers[m.task];groups<<id<<','<<P(x.physical).expert<<','<<x.source<<','<<m.task<<','<<x.target<<','<<x.physical<<','<<x.bytes<<','<<taskAudit[m.task].finish<<','<<multicastV2.senderTimes.at(m.task)<<','<<multicastV2.completeTimes.at(id)<<'\n';}stats<<id<<','<<g.source<<','<<g.members.size()<<','<<g.codec->payloadSent<<','<<g.codec->wireDataBytes<<','<<g.codec->envelopes<<','<<(g.members.size()==1?g.grants:0)<<','<<g.codec->chargedHeaderBytes<<','<<g.codec->capacity<<','<<g.codec->peakRecords<<','<<g.codec->restored<<','<<g.grants<<','<<g.admittedPs<<','<<g.releasedPs<<'\n';}
        std::ofstream ports(out+"/multicast-ports.csv");ports<<"node,port,wire_tx_bytes,peak_egress_bytes,consumed_cells,returned_cells,restored_cells,free_cells,pending_cells,blocked_queries\n";
        for(uint32_t rank=0;rank<nodes.size();++rank)for(uint32_t p=0;p<nodes[rank]->GetNDevices();++p){auto port=DynamicCast<UbPort>(nodes[rank]->GetDevice(p));auto fc=DynamicCast<UbCbfc>(port->GetFlowControl());Require(fc&&!port->GetUbQueue()->GetCurrentBytes(),"v2 port drain");auto peer=DynamicCast<UbPort>(nodes[rank==n?p:n]->GetDevice(rank==n?0:rank));auto f=DynamicCast<UbCbfc>(peer->GetFlowControl());Require(portInitialCredit.at({rank,p})-int64_t(fc->GetConsumedCells())+int64_t(fc->GetRestoredCells())==fc->GetTxFreeCells(7)&&fc->GetConsumedCells()==f->GetReturnedCells()&&f->GetReturnedCells()==fc->GetRestoredCells()+uint64_t(f->GetCrdToReturn(7)),"v2 credit conservation");ports<<rank<<','<<p<<','<<portTxWire[{rank,p}]<<','<<portQueuePeak[{rank,p}]<<','<<fc->GetConsumedCells()<<','<<fc->GetReturnedCells()<<','<<fc->GetRestoredCells()<<','<<fc->GetTxFreeCells(7)<<','<<fc->GetCrdToReturn(7)<<','<<fc->GetBlockedQueryCount()<<'\n';}
        auto sw=nodes[n]->GetObject<UbSwitch>();auto s=sw->GetNetworkReplicationStats();Require(s.admitted==s.released&&s.branches==s.branchDequeues&&!s.parentBytes&&!s.branchBytes&&!s.descriptors&&!sw->GetQueueManager()->GetSwitchBufferOccupancy().total_buffered_bytes,"v2 switch drain");
        uint64_t invalidations=0;for(auto&[key,p]:multicastV2.pairs)invalidations+=p->invalidatedGrants;Require(!invalidateGrant||invalidations==1,"stale grant injection missing");
        std::ofstream life(out+"/multicast-lifecycle.json");life<<"{\"status\":\"PASS\",\"pair_proxies\":"<<multicastV2.pairs.size()<<",\"association_limit\":"<<multicastV2.totalAssociationLimit<<",\"envelopes\":"<<s.admitted<<",\"branches\":"<<s.branches<<",\"input_release_bytes\":"<<s.upstreamReturnBytes<<",\"native_retry_packets\":"<<multicastV2.retries<<",\"injected_losses\":"<<networkFaultCount<<",\"pending_associations\":0,\"invalidated_grants\":"<<invalidations<<",\"pair_jetties\":"<<pairJetties->Size()<<"}\n";
        std::ofstream ready(out+"/weight-ready.csv");ready<<"expert,main_source,fanout,ready_ps,sender_complete_ps\n";for(auto&[id,g]:multicastV2.groups){uint64_t when=0;for(auto&m:g.members)when=std::max(when,taskAudit[m.task].finish);ready<<id-1<<','<<g.source<<','<<g.members.size()<<','<<when<<','<<multicastV2.completeTimes.at(id)<<'\n';}
    }

    void WriteUniformResources(const std::string& out){
        std::ofstream ready(out+"/replica-ready.csv");ready<<"expert,physical,main_source,target,ready_ps\n";std::map<uint32_t,uint64_t> expertTimes;std::map<uint32_t,uint32_t> fanouts;
        for(auto&ph:physical)if(ph.replica){auto time=replicaReadyTimes.at(ph.id);ready<<ph.expert<<','<<ph.id<<','<<ph.mainRank<<','<<ph.rank<<','<<time<<'\n';expertTimes[ph.expert]=std::max(expertTimes[ph.expert],time);++fanouts[ph.expert];}
        std::ofstream expert(out+"/expert-ready.csv");expert<<"expert,fanout,ready_ps\n";for(auto&[id,time]:expertTimes)expert<<id<<','<<fanouts[id]<<','<<time<<'\n';
        std::ofstream tpstate(out+"/pair-state.csv");tpstate<<"source,target,tpn,send_una,send_nxt,recv_nxt,unacked,descriptors,timer,jetty,active_wqes,ta_una,ta_nxt\n";
        for(uint32_t a=0;a<n;++a)for(uint32_t b=0;b<n;++b)if(a!=b){auto tp=Ctrl(a)->GetTransportChannelManager()->GetTp(Tpn(a,b));if(!tp)continue;Require(tp->IsSafeForExplicitDestroy(),"uniform TP must safely drain");auto j=Ctrl(a)->GetUbFunction()->GetJetty(Tpn(a,b));tpstate<<a<<','<<b<<','<<tp->GetTpn()<<','<<tp->GetPsnSndUna()<<','<<tp->GetPsnSndNxt()<<','<<tp->GetPsnRecvNxt()<<','<<tp->GetOutstandingUnackedSegmentCount()<<','<<tp->GetGbnDescriptorCountForTest()<<','<<tp->IsRetransTimerRunningForTest()<<','<<(j?Tpn(a,b):0)<<','<<(j?j->GetActiveWqeCount():0)<<','<<(j?j->GetTaSsnSndUnaForTest():0)<<','<<(j?j->GetTaSsnSndNxtForTest():0)<<'\n';}
        std::ofstream f(out+"/network-resources.csv");f<<"node,port,peak_ingress_bytes,peak_voq_out_bytes,peak_egress_bytes,consumed,returned,restored,pending,blocked\n";
        for(uint32_t rank=0;rank<nodes.size();++rank){auto sw=nodes[rank]->GetObject<UbSwitch>();Require(!sw->GetQueueManager()->GetSwitchBufferOccupancy().total_buffered_bytes,"uniform switch buffer drain");for(uint32_t p=0;p<nodes[rank]->GetNDevices();++p){auto port=DynamicCast<UbPort>(nodes[rank]->GetDevice(p));auto fc=DynamicCast<UbCbfc>(port->GetFlowControl());auto peer=DynamicCast<UbPort>(nodes[rank==n?p:n]->GetDevice(rank==n?0:rank));auto other=DynamicCast<UbCbfc>(peer->GetFlowControl());Require(fc&&other&&!port->GetUbQueue()->GetCurrentBytes(),"uniform queue/CBFC drain");Require(fc->GetConsumedCells()==other->GetReturnedCells()&&fc->GetConsumedCells()==fc->GetRestoredCells()+uint64_t(other->GetCrdToReturn(7)),"uniform credit conservation");f<<rank<<','<<p<<','<<ingressPeak[{rank,p}]<<','<<voqPeak[{rank,p}]<<','<<portQueuePeak[{rank,p}]<<','<<fc->GetConsumedCells()<<','<<fc->GetReturnedCells()<<','<<fc->GetRestoredCells()<<','<<fc->GetCrdToReturn(7)<<','<<fc->GetBlockedQueryCount()<<'\n';}}
    }
